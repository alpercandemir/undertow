{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "enabled", "owner", "required_contracts"],
  "properties": {
    "schema_version": {"const": 1}, "enabled": {"type": "boolean"},
    "owner": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "required_contracts": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,79}$"}},
    "exceptions": {"type": "array", "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "contract_id", "head_sha", "owner", "reason", "expires"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 100},
        "contract_id": {"type": "string"}, "head_sha": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
        "owner": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"}, "reason": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
        "expires": {"type": "string", "minLength": 1, "maxLength": 50}
      }
    }}
  }
}
