{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "maxLength": 100000
    },
    "base_sha": {
      "type": "string",
      "maxLength": 100000
    },
    "head_sha": {
      "type": "string",
      "maxLength": 100000
    },
    "model_identity": {
      "type": "string",
      "maxLength": 100000
    },
    "prompt_version": {
      "type": "string",
      "maxLength": 100000
    },
    "summary": {
      "type": "string",
      "maxLength": 100000
    },
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed",
        "skipped"
      ]
    },
    "prompt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,60}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "language": {
            "type": "string",
            "enum": [
              "java"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL",
              "HIGH_CRITICAL"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "CORRECTNESS",
              "SECURITY",
              "DATA_INTEGRITY",
              "CONCURRENCY",
              "TRANSACTIONS",
              "RELIABILITY",
              "DEPENDENCY_COMPATIBILITY",
              "API_CONTRACT",
              "PERFORMANCE",
              "MAINTAINABILITY",
              "STYLE"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "confidence_explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "OBSERVED",
              "INFERRED",
              "UNVERIFIED"
            ]
          },
          "guideline_label": {
            "type": "string",
            "enum": [
              "BLOCKER",
              "MAJOR",
              "MINOR",
              "SUGGESTION"
            ]
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "minItems": 1,
            "maxItems": 30
          },
          "location": {
            "type": "object",
            "properties": {
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "snapshot": {
                "type": "string",
                "enum": [
                  "base",
                  "head"
                ]
              },
              "start_line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "end_line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              }
            },
            "required": [
              "commit",
              "path",
              "snapshot",
              "start_line",
              "end_line"
            ],
            "additionalProperties": false
          },
          "trigger": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "changed_behavior": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "technical_consequence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "business_consequence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "minItems": 0,
            "maxItems": 30
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "minItems": 1,
            "maxItems": 30
          },
          "recommended_change": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "regression_tests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "setup": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "stimulus": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "expected_outcome": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "level": {
                  "type": "string",
                  "enum": [
                    "unit",
                    "integration",
                    "contract",
                    "system"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "proposed",
                    "executed/passed",
                    "executed/failed",
                    "not executable here"
                  ]
                }
              },
              "required": [
                "setup",
                "stimulus",
                "expected_outcome",
                "level",
                "status"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 30
          }
        },
        "required": [
          "id",
          "title",
          "language",
          "severity",
          "category",
          "confidence",
          "confidence_explanation",
          "evidence_status",
          "guideline_label",
          "rule_ids",
          "location",
          "trigger",
          "changed_behavior",
          "technical_consequence",
          "business_consequence",
          "assumptions",
          "evidence_refs",
          "recommended_change",
          "regression_tests"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 25
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100000
      },
      "maxItems": 1000
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100000
      },
      "maxItems": 1000
    },
    "inspected_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100000
      },
      "maxItems": 1000
    },
    "tool_failures": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100000
      },
      "maxItems": 1000
    },
    "model_calls": {
      "type": "integer",
      "minimum": 0
    },
    "tool_calls": {
      "type": "integer",
      "minimum": 0
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "estimated_input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "elapsed_millis": {
      "type": "integer",
      "minimum": 0
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "failure_cause",
        "runtime_version",
        "analyzer_version",
        "policy_commit",
        "rule_coverage",
        "ci_evidence",
        "target_head"
      ],
      "properties": {
        "mode": {
          "enum": [
            "live",
            "replay",
            "collect"
          ]
        },
        "failure_cause": {
          "enum": [
            "none",
            "authentication",
            "model_access",
            "quota",
            "rate_limit",
            "timeout",
            "invalid_output",
            "unavailable",
            "budget"
          ]
        },
        "runtime_version": {
          "type": "string"
        },
        "analyzer_version": {
          "type": "string"
        },
        "policy_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "rule_coverage": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "status",
              "reason",
              "paths",
              "exceptions"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 8000
              },
              "version": {
                "type": "string",
                "maxLength": 8000
              },
              "reason": {
                "type": "string",
                "maxLength": 8000
              },
              "status": {
                "enum": [
                  "selected",
                  "evaluated",
                  "not_evaluated",
                  "out_of_scope",
                  "exception"
                ]
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exceptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "ci_evidence": {
          "type": "object"
        },
        "target_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "dependency_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    }
  },
  "required": [
    "run_id",
    "base_sha",
    "head_sha",
    "model_identity",
    "prompt_version",
    "summary",
    "schema_version",
    "status",
    "prompt_hash",
    "evidence_hash",
    "policy_hashes",
    "findings",
    "coverage_gaps",
    "changed_files",
    "inspected_sources",
    "tool_failures",
    "model_calls",
    "tool_calls",
    "input_tokens",
    "output_tokens",
    "estimated_input_tokens",
    "elapsed_millis"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "details"
        ]
      },
      "else": {
        "not": {
          "required": [
            "details"
          ]
        }
      }
    }
  ]
}
