{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "owner", "environment", "contract_id", "minimum_events", "minimum_window_seconds", "maximum_age_seconds", "maximum_detection_seconds", "reconciliation_required"],
  "properties": {
    "schema_version": {"const": 1}, "owner": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "environment": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
    "contract_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,79}$"},
    "minimum_events": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "minimum_window_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
    "maximum_age_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
    "maximum_detection_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "reconciliation_required": {"type": "boolean"}
  }
}
