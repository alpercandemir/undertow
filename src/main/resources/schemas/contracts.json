{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "oracle_paths", "contracts"],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "maxLength": 200},
    "oracle_paths": {"$ref": "#/$defs/paths"},
    "oracle_roots": {"$ref": "#/$defs/paths"},
    "regression_artifacts": {"type": "array", "maxItems": 10, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "sha256"],
      "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }},
    "contracts": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version", "owner", "expectation", "scope", "verifier", "tests"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,79}$"},
          "version": {"type": "string", "pattern": "^[1-9][0-9]{0,8}$"},
          "owner": {"$ref": "#/$defs/text"},
          "expectation": {"$ref": "#/$defs/text"},
          "assumptions": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/text"}},
          "scope": {"$ref": "#/$defs/paths"},
          "verifier": {"const": "junit"},
          "tests": {
            "type": "array", "minItems": 1, "maxItems": 100, "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "sources"],
              "properties": {
                "id": {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$.]*\\.[^\\s]+$", "maxLength": 300},
                "artifact": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
                "sources": {"$ref": "#/$defs/paths"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
    "paths": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}}
  }
}
